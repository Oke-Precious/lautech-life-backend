# ==============================================================================
# LAUTECH Life Backend — Environment Configuration (.env.example)
# Phase 1B: Active configuration and future integration placeholders
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Confirmed Database: Supabase PostgreSQL (Phase 1 Documentation Placeholder)
# ------------------------------------------------------------------------------
# NOT REQUIRED during Phase 1B.
# In Phase 2, this will be connected using a dedicated, least-privilege role.
# Never commit real connection strings or passwords to Git.
#
# DATABASE_URL=YOUR_LEAST_PRIVILEGE_BACKEND_CONNECTION_URL
# DATABASE_POOL_MAX=5

# ------------------------------------------------------------------------------
# 3. Confirmed Authentication: Supabase Auth (Phase 1 Documentation Placeholder)
# ------------------------------------------------------------------------------
# NOT REQUIRED during Phase 1B.
# In Phase 2, Express will verify JWT access tokens from this project.
#
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional server-only administrative key (NEVER exposed to clients):
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
